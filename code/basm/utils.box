

box strcpy_3[char* dst, char* src] (
    dst[0] : src[0]
    dst[1] : src[1]
    dst[2] : src[2]
)

box strcpy_2[char* dst, char* src] (
    dst[0] : src[0]
    dst[1] : src[1]
)

box strcmp_3[char* s1, char* s2] (
    if [s1[0] == s2[0]] (
        if [s1[1] == s2[1]] (
            if [s1[2] == s2[2]] (
                ret 1
            )
        )
    )

    ret 0
)

box strcmp_2[char* s1, char* s2] (
    if [s1[0] == s2[0]] (
        if [s1[1] == s2[1]] (
            ret 1
        )
    )
    ret 0
)

